{
    "name": "bladewell/bladewell",
    "description": "Copy-paste Blade + Tailwind v4 widgets for Laravel. The installer copies the source into your app; you own it from there.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "livewire", "blade", "blade-components", "tailwindcss", "ui-components", "components", "widgets", "forms", "datepicker"],
    "homepage": "https://www.bladewellui.com",
    "authors": [
        {
            "name": "Krishnaprasad R",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/rkwebforge/bladewell-site/issues",
        "docs": "https://www.bladewellui.com/docs/installation",
        "source": "https://github.com/rkwebforge/bladewell"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/prompts": "^0.3"
    },
    "autoload": {
        "psr-4": {
            "Bladewell\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bladewell\\BladewellServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
